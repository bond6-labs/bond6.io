{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bond6-transmissions",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "assets": { "directory": "./public" },
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "MAX_STORIES": "1000", "TRANSLATE_HEADLINES": "true" },
  "ai": { "binding": "AI" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "bond6-transmissions",
    "database_id": "e49635ca-21ce-4511-a35b-7aa52edbb696"
  }],
  "observability": { "enabled": true }
}
